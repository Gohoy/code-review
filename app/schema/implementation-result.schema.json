{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "question"],
  "properties": {
    "status": {"enum": ["COMPLETED", "NEEDS_INPUT", "FAILED"]},
    "summary": {"type": "string", "minLength": 1},
    "question": {"type": "string"}
  }
}
