{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdbp.local/review/graph.schema.json",
  "title": "sdbp-review 统一图模型",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modelId", "title", "revision", "graph"],
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "graph": {
            "required": ["codeSnapshots"]
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2]
    },
    "modelId": {
      "$ref": "#/$defs/stableId"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "graph": {
      "$ref": "#/$defs/graph"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": ["DECLARED", "DERIVED", "OBSERVED", "INFERRED", "UNRESOLVED"]
    },
    "layerId": {
      "enum": ["requirement", "design", "implementation", "verification"]
    },
    "sourcePosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column"],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "$ref": "#/$defs/sourcePosition"
        },
        "end": {
          "$ref": "#/$defs/sourcePosition"
        }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "codeAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "path", "range", "extractorId", "fingerprint"],
      "properties": {
        "snapshotId": {
          "$ref": "#/$defs/stableId"
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "range": {
          "$ref": "#/$defs/sourceRange"
        },
        "extractorId": {
          "$ref": "#/$defs/stableId"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "codeSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repositoryId",
        "commitSha",
        "treeHash",
        "scanHash",
        "roots",
        "extractors"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "repositoryId": {
          "$ref": "#/$defs/stableId"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "treeHash": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "scanHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "extractors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/extractor"
          }
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "baseRevisionId", "contentHash", "approvable"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "status": {
          "enum": ["CANDIDATE", "APPROVED", "SUPERSEDED"]
        },
        "baseRevisionId": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approvable": {
          "type": "boolean"
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": {
          "$ref": "#/$defs/layerId"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layer", "kind", "title", "summary", "source", "details"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "layer": {
          "$ref": "#/$defs/layerId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Actor",
            "Goal",
            "Flow",
            "Scenario",
            "Action",
            "Decision",
            "State",
            "Rule",
            "Outcome",
            "Question",
            "Screen",
            "Component",
            "Interface",
            "DataStore",
            "DataEntity",
            "ExternalSystem",
            "RuntimeBoundary",
            "Repository",
            "Module",
            "Symbol",
            "EntryPoint",
            "Configuration",
            "Test",
            "TestRun",
            "Evidence"
          ]
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "details": {
          "type": "object"
        },
        "snapshotId": {
          "$ref": "#/$defs/stableId"
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/codeAnchor"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "targetId", "kind", "source"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "sourceId": {
          "$ref": "#/$defs/stableId"
        },
        "targetId": {
          "$ref": "#/$defs/stableId"
        },
        "kind": {
          "enum": [
            "contains",
            "initiates",
            "next",
            "branch",
            "transitions",
            "guarded_by",
            "produces",
            "affects",
            "blocks",
            "realized_by",
            "implemented_by",
            "verified_by",
            "exposes",
            "calls",
            "reads",
            "writes",
            "invokes",
            "creates",
            "renders",
            "configured_by",
            "evidenced_by",
            "constrains"
          ]
        },
        "label": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "snapshotId": {
          "$ref": "#/$defs/stableId"
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/codeAnchor"
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "entryNodeIds", "nodes", "edges"],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/layer"
          }
        },
        "entryNodeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "codeSnapshots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/codeSnapshot"
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    }
  }
}
